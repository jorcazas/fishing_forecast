\@writefile{lot}{\contentsline {table}{\numberline {5.9}{\ignorespaces Modelos puntuales de langosta $\times $ San Quintín re-entrenados sobre el conjunto unido 2017-2026, en los dos cortes de prueba (MAE, RMSE y sMAPE diarios, kg). En negrita, el mejor modelo de cada corte. Pasar de 3 a 7 temporadas de entrenamiento reduce el error diario a aproximadamente la mitad en los modelos tabulares ---y \emph  {invierte} el orden entre ellos y los recurrentes. El ensamble XGBoost+LSTM es el de la primera iteración original (la predicción de XGBoost entra a la LSTM como regresor extra), aquí con esa columna construida fuera de muestra en el entrenamiento.}}{44}{table.5.9}\protected@file@percent }
\newlabel{tab:extension_comparativa}{{5.9}{44}{Modelos puntuales de langosta $\times $ San Quintín re-entrenados sobre el conjunto unido 2017-2026, en los dos cortes de prueba (MAE, RMSE y sMAPE diarios, kg). En negrita, el mejor modelo de cada corte. Pasar de 3 a 7 temporadas de entrenamiento reduce el error diario a aproximadamente la mitad en los modelos tabulares ---y \emph {invierte} el orden entre ellos y los recurrentes. El ensamble XGBoost+LSTM es el de la primera iteración original (la predicción de XGBoost entra a la LSTM como regresor extra), aquí con esa columna construida fuera de muestra en el entrenamiento}{table.5.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5.2}{\ignorespaces Langosta $\times $ San Quintín, observado (negro) vs. pronosticado por el XGBoost completo (35 vars, rojo) y el podado por SHAP ($\sim $16 vars, verde), en los dos cortes. Con el entrenamiento corto (arriba, hasta jun-2020) el modelo extrapola el régimen pre-bache y sobre-predice todas las temporadas post-2021; con el entrenamiento largo (abajo, hasta may-2024, con el bache incluido) sigue las temporadas recientes de captura reducida. Eje $y$ recortado a 3$\times $ el máximo observado.}}{45}{figure.5.2}\protected@file@percent }
\newlabel{fig:extension_comparativa}{{5.2}{45}{Langosta $\times $ San Quintín, observado (negro) vs. pronosticado por el XGBoost completo (35 vars, rojo) y el podado por SHAP ($\sim $16 vars, verde), en los dos cortes. Con el entrenamiento corto (arriba, hasta jun-2020) el modelo extrapola el régimen pre-bache y sobre-predice todas las temporadas post-2021; con el entrenamiento largo (abajo, hasta may-2024, con el bache incluido) sigue las temporadas recientes de captura reducida. Eje $y$ recortado a 3$\times $ el máximo observado}{figure.5.2}{}}
